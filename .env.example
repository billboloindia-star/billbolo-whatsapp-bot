# WhatsApp Cloud API Configuration
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets API Configuration
GOOGLE_SHEETS_CREDENTIALS_JSON=your_google_sheets_service_account_json
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets

# Cashfree Payment Configuration
CASHFREE_API_KEY=your_cashfree_api_key
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# AWS Configuration (auto-configured by Serverless)
AWS_REGION=us-east-1
DYNAMODB_TABLE=billbolo-whatsapp-bot-prod
S3_BUCKET=billbolo-pdfs-prod

# Application Configuration
STAGE=development
DEBUG=false
LOG_LEVEL=INFO

# Pricing Configuration
FREE_CREDITS=5
PRO_MONTHLY_PRICE_INR=499
PRO_YEARLY_PRICE_INR=4999

# Bot Configuration
BOT_NAME=BillBolo
BOT_GREETING_MESSAGE=Hi! I'm BillBolo, your WhatsApp billing assistant. What's your business name?
